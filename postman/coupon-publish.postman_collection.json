{
  "info": {
    "_postman_id": "e9c6285e-3b4a-4d3e-8fd6-0f3e06e1e141",
    "name": "Coupon Publish API - Redis Kafka Flink",
    "description": "쿠폰 생성, 발급, Redis 남은 수량 조회, Flink Redis 집계 조회를 확인하는 최소 Postman 컬렉션입니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. 쿠폰 생성",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const now = new Date();",
              "const startAt = new Date(now.getTime() - 60 * 1000);",
              "const endAt = new Date(now);",
              "endAt.setFullYear(endAt.getFullYear() + 1);",
              "const format = (date) => date.toISOString().slice(0, 19);",
              "pm.variables.set('couponName', `postman-coupon-${Date.now()}`);",
              "pm.variables.set('startAt', format(startAt));",
              "pm.variables.set('endAt', format(endAt));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('couponId 저장', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.couponId).to.exist;",
              "  pm.environment.set('couponId', body.couponId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{couponName}}\",\n  \"maxCount\": 5,\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/coupons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "coupons"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02. 쿠폰 단건 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('couponId 확인', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(String(body.couponId)).to.eql(String(pm.environment.get('couponId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/coupons/{{couponId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "coupons",
            "{{couponId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03. 쿠폰 발급",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('발급 상태 확인', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.userId).to.eql(pm.environment.get('userId'));",
              "  pm.expect(body.status).to.eql('ISSUED');",
              "  pm.expect(body.couponIssueId).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/coupons/{{couponId}}/issues",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "coupons",
            "{{couponId}}",
            "issues"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04. 남은 수량 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('남은 수량은 4', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.remainingCount).to.eql(4);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/coupons/{{couponId}}/remaining",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "coupons",
            "{{couponId}}",
            "remaining"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05. 발급 집계 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('집계 응답 구조 확인', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.couponId).to.exist;",
              "  pm.expect(body.issuedCount).to.be.a('number');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/coupons/{{couponId}}/statistics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "coupons",
            "{{couponId}}",
            "statistics"
          ]
        }
      },
      "response": []
    }
  ]
}
