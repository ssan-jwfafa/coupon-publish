{
  "info": {
    "_postman_id": "e9c6285e-3b4a-4d3e-8fd6-0f3e06e1e141",
    "name": "Coupon Publish API",
    "description": "Postman collection for the Coupon Publish Spring Boot API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "couponId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "user-1"
    },
    {
      "key": "missingUserId",
      "value": "missing-user"
    }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Create Coupon Campaign",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('response has coupon id', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.couponId).to.exist;",
                  "  pm.collectionVariables.set('couponId', body.couponId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Welcome Coupon\",\n  \"maxCount\": 100,\n  \"startAt\": \"2026-01-01T00:00:00\",\n  \"endAt\": \"2026-12-31T23:59:59\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Coupon Campaign",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/{{couponId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "{{couponId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Remaining Coupons",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/{{couponId}}/remaining",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "{{couponId}}",
                "remaining"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Issue Coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('response has issued coupon', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.couponId).to.eql(Number(pm.collectionVariables.get('couponId') || pm.variables.get('couponId')));",
                  "  pm.expect(body.userId).to.eql(pm.variables.get('userId'));",
                  "  pm.expect(body.status).to.eql('ISSUED');",
                  "  pm.expect(body.couponIssueId).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons/{{couponId}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "{{couponId}}",
                "issues"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Coupon Issue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('response has requested user', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.eql(pm.variables.get('userId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/{{couponId}}/issues/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "{{couponId}}",
                "issues",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Coupon Issues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/{{couponId}}/issues?status=ISSUED&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "{{couponId}}",
                "issues"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ISSUED"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cancel Coupon Issue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('coupon is canceled', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.eql(pm.variables.get('userId'));",
                  "  pm.expect(body.status).to.eql('CANCELED');",
                  "  pm.expect(body.canceledAt).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/{{couponId}}/issues/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "{{couponId}}",
                "issues",
                "{{userId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
