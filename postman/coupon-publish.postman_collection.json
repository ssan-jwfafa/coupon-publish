{
  "info": {
    "_postman_id": "e9c6285e-3b4a-4d3e-8fd6-0f3e06e1e141",
    "name": "Coupon Publish API",
    "description": "Postman collection for the Coupon Publish Spring Boot API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": "user-1"
    },
    {
      "key": "missingUserId",
      "value": "missing-user"
    }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Get Remaining Coupons",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/remaining",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "remaining"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Issue Coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('response has issued coupon', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.eql(pm.variables.get('userId'));",
                  "  pm.expect(body.status).to.eql('ISSUED');",
                  "  pm.expect(body.couponIssueId).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "issues"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Coupon Issue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('response has requested user', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.eql(pm.variables.get('userId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/issues/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "issues",
                "{{userId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cancel Coupon Issue",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('coupon is canceled', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.eql(pm.variables.get('userId'));",
                  "  pm.expect(body.status).to.eql('CANCELED');",
                  "  pm.expect(body.canceledAt).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/issues/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "issues",
                "{{userId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
